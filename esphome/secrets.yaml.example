# Copy to esphome/secrets.yaml (gitignored) and fill in.
# Wi-Fi must be Home Assistant's own LAN: HA connects *to* ESPHome devices.
wifi_ssid: "your-wifi"
wifi_password: "your-password"
api_key: "32 random bytes, base64"        # e.g. openssl rand -base64 32
ota_password: "any random string"
fallback_ap_password: "password for the fallback setup hotspot"

# second glucose readout (Medtronic CareLink)
carelink_label: "Name"
carelink_value_entity: sensor.<name>_carelink_<name>_last_glucose_level_mg_dl
carelink_trend_entity: sensor.<name>_carelink_<name>_last_glucose_trend
carelink_delta_entity: sensor.<name>_carelink_<name>_last_glucose_delta
