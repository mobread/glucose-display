// Copy to include/secrets.h and fill in. secrets.h is gitignored.
#pragma once

// WiFi. On the Waveshare build these are only the fallback: a network chosen on the device's
// WiFi setup screen is saved to flash and used first. Leave "" to always start in setup.
#define WIFI_SSID     "your-wifi"
#define WIFI_PASS     "your-password"

// ---- Per-board WiFi override: the T-Display-S3 has no WireGuard, so it must join HA's own LAN ----
#if defined(BOARD_TDISPLAY_S3)
#undef WIFI_SSID
#undef WIFI_PASS
#define WIFI_SSID     "YOUR_HOME_WIFI"     // the network Home Assistant is on
#define WIFI_PASS     "YOUR_HOME_WIFI_PASSWORD"
#endif

// Plain HTTP on the same LAN as the panel. HTTPS won't work (not enough RAM for TLS
// alongside the display), and cross-VLAN traffic is often blocked by default.
#define HA_BASE_URL   "http://homeassistant.local:8123"   // no trailing slash
#define HA_TOKEN      "eyJ...long-lived access token..."

#define HA_ENTITY_VALUE      "sensor.dexcom_glucose_value"
#define HA_ENTITY_TREND      "sensor.dexcom_glucose_trend"
#define HA_ENTITY_BRIGHTNESS "input_number.glucose_panel_brightness"   // 0-100 slider helper

// ---- Optional: WireGuard tunnel home (Waveshare ESP32-P4 build only) ----
// Lets the panel reach HA's LAN address from another network. HA_BASE_URL stays the plain
// http://<LAN IP or LAN hostname>:8123 -- for a LAN-only hostname (e.g. "ha.home.lan") set
// WG_DNS to your home DNS server so it resolves through the tunnel. Values map 1:1 to a
// wg-quick .conf: [Interface] PrivateKey/Address/DNS, [Peer] PublicKey/Endpoint/PresharedKey.
// Set WG_ENABLE to 0 (or omit) on the home LAN.
#define WG_ENABLE           0
#define WG_ENDPOINT         "vpn.example.com"     // server hostname or IP
#define WG_PORT             51820
#define WG_PRIVATE_KEY      "panel private key (base64)"
#define WG_PEER_PUBLIC_KEY  "server public key (base64)"
#define WG_PRESHARED_KEY    ""                    // optional, "" if unused
#define WG_ADDRESS          "10.0.0.20"           // the panel's tunnel IP
#define WG_NETMASK          "255.255.255.255"
#define WG_DNS              ""                    // DNS through the tunnel, e.g. home router "192.168.1.1"; "" = local DNS
#define WG_KEEPALIVE        25                    // seconds; keeps the remote network's NAT open
