// Copy to include/secrets.h and fill in. secrets.h is gitignored.
#pragma once

#define WIFI_SSID     "your-wifi"
#define WIFI_PASS     "your-password"

// Plain HTTP on the same LAN as the panel. HTTPS won't work (not enough RAM for TLS
// alongside the display), and cross-VLAN traffic is often blocked by default.
#define HA_BASE_URL   "http://homeassistant.local:8123"   // no trailing slash
#define HA_TOKEN      "eyJ...long-lived access token..."

#define HA_ENTITY_VALUE      "sensor.dexcom_glucose_value"
#define HA_ENTITY_TREND      "sensor.dexcom_glucose_trend"
#define HA_ENTITY_BRIGHTNESS "input_number.glucose_panel_brightness"   // 0-100 slider helper
